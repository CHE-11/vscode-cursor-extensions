// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Package VSIX",
			"type": "shell",
			"command": "pnpm run package",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always"
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"statusbar": {
					"hide": false,
					"color": "#a020f0"
				}
			}
		}
	]
}
