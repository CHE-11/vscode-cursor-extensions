{
  "name": "ce-auto-rename-tag",
  "displayName": "CE | Auto Rename Tag",
  "description": "Rename the paired HTML or XML tag while you type.",
  "version": "1.0.12",
  "publisher": "che-11",
  "author": "che-11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHE-11/vscode-cursor-extensions.git",
    "directory": "auto-rename-tag"
  },
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "rename",
    "tag",
    "html",
    "xml"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Auto Rename Tag",
      "properties": {
        "auto-rename-tag.activationOnLanguage": {
          "type": "array",
          "default": [
            "*"
          ],
          "description": "Language ids that activate paired tag renaming. Use [\"*\"] for every language.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "pnpm run compile && node --test out/src/doAutoRenameTag.test.js",
    "package": "node package.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "~1.88.0",
    "typescript": "^5.3.3"
  }
}
