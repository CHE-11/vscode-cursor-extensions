{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Deps",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#b7a200"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Watch",
      "type": "shell",
      "command": "pnpm run watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#06b724"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm run compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#1674e6"
        }
      }
    },
    {
      "label": "Package VSIX",
      "type": "shell",
      "command": "pnpm run package",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}",
				"statusbar": {
					"hide": false,
					"color": "#a020f0"
				}
      }
    }
  ]
}
