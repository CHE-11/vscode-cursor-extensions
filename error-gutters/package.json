{
  "name": "ce-error-gutters",
  "displayName": "CE | Error Gutters",
  "description": "Show error, warning, and info icons in the gutter beside the line numbers.",
  "version": "1.0.4",
  "license": "GPLv3",
  "publisher": "che-11",
  "author": "che-11",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHE-11/vscode-cursor-extensions.git",
    "directory": "error-gutters"
  },
  "icon": "img/icon.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "error",
    "warning",
    "gutter",
    "diagnostic",
    "linter"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pnpm version patch --no-git-tag-version && pnpm run compile && node package.js"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "~1.88.0",
    "typescript": "^5.3.3"
  }
}
